DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Sales tax as a decimal multiplier. 0.09375 == 9.375% (Healdton, OK).
SALES_TAX_RATE="0.09375"

# QuickBooks Online (Intuit developer app). QBO_ENVIRONMENT is "sandbox" or
# "production"; the redirect URI must be registered on the Intuit app exactly.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
QBO_ENVIRONMENT=sandbox
